generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario        Int             @id @default(autoincrement())
  nombre_completo   String          @db.VarChar(150)
  email             String          @unique @db.VarChar(150)
  password_hash     String          @db.VarChar(255)
  rol               String          @default("cliente") @db.VarChar(20)
  telefono          String?         @db.VarChar(20)
  dni_ruc           String?         @db.VarChar(20)
  pais_region       String?         @default("Perú") @db.VarChar(80)
  direccion_calle   String?
  poblacion         String?         @db.VarChar(120)
  region_provincia  String?         @default("Lima") @db.VarChar(120)
  codigo_postal     String?         @db.VarChar(20)
  fecha_registro    DateTime        @default(now()) @db.Timestamp(6)
  pedidos           Pedido[]
  mensajes_pedidos  MensajePedido[]
  resenas           ResenaProducto[]

  @@map("usuarios")
}

model Categoria {
  id_categoria Int        @id @default(autoincrement())
  nombre       String     @unique @db.VarChar(100)
  productos    Producto[]

  @@map("categorias")
}

model Producto {
  id_producto       Int              @id @default(autoincrement())
  id_categoria      Int?
  nombre            String           @db.VarChar(150)
  descripcion       String?
  precio_base       Decimal          @db.Decimal(10, 2)
  precio_oferta     Decimal?         @db.Decimal(10, 2)
  stock             Int              @default(0)
  imagen_url        String?          @db.VarChar(255)
  activo            Boolean          @default(true)
  destacado         Boolean          @default(false)
  etiqueta_badge    String?          @db.VarChar(40)
  ventas_totales    Int              @default(0)
  rating_promedio   Decimal          @default(0) @db.Decimal(3, 2)
  total_resenas     Int              @default(0)
  categoria         Categoria?       @relation(fields: [id_categoria], references: [id_categoria], onDelete: SetNull)
  escalas_precios   EscalaPrecio[]
  imagenes          ImagenProducto[]
  opciones          OpcionProducto[]
  detalles_pedidos  DetallePedido[]
  resenas           ResenaProducto[]

  @@index([id_categoria], map: "idx_productos_categoria")
  @@index([activo, destacado], map: "idx_productos_activo_destacado")
  @@map("productos")
}

model EscalaPrecio {
  id_escala       Int      @id @default(autoincrement())
  id_producto     Int
  cantidad_min    Int
  precio_unitario Decimal  @db.Decimal(10, 2)
  producto        Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@unique([id_producto, cantidad_min], map: "uq_escala_producto")
  @@index([id_producto], map: "idx_escalas_producto")
  @@map("escalas_precios")
}

model ImagenProducto {
  id_imagen    Int      @id @default(autoincrement())
  id_producto  Int
  url          String   @db.VarChar(500)
  alt          String?  @db.VarChar(180)
  vista        String   @default("Principal") @db.VarChar(40)
  orden        Int      @default(0)
  producto     Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@index([id_producto], map: "idx_imagenes_producto")
  @@map("producto_imagenes")
}

model OpcionProducto {
  id_opcion    Int      @id @default(autoincrement())
  id_producto  Int
  tipo         String   @db.VarChar(30)
  nombre       String   @db.VarChar(80)
  recargo      Decimal  @default(0) @db.Decimal(10, 2)
  requerido    Boolean  @default(false)
  orden        Int      @default(0)
  producto     Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)

  @@index([id_producto], map: "idx_opciones_producto")
  @@map("producto_opciones")
}

model Distrito {
  id_distrito     Int      @id @default(autoincrement())
  nombre          String   @unique @db.VarChar(100)
  costo_delivery  Decimal  @db.Decimal(10, 2)
  pedidos         Pedido[]

  @@map("distritos")
}

model Pedido {
  id_pedido        Int             @id @default(autoincrement())
  id_usuario       Int
  id_distrito      Int
  direccion_envio  String
  fecha_pedido     DateTime        @default(now()) @db.Timestamp(6)
  fecha_actualizacion DateTime     @default(now()) @db.Timestamp(6)
  estado           String          @default("Pendiente") @db.VarChar(50)
  metodo_pago      String?         @db.VarChar(50)
  pais_region      String?         @default("Perú") @db.VarChar(80)
  direccion_calle  String?
  poblacion        String?         @db.VarChar(120)
  region_provincia String?         @default("Lima") @db.VarChar(120)
  codigo_postal    String?         @db.VarChar(20)
  telefono_contacto String?        @db.VarChar(20)
  total_productos  Decimal         @default(0) @db.Decimal(12, 2)
  costo_envio      Decimal         @default(0) @db.Decimal(10, 2)
  monto_total      Decimal         @default(0) @db.Decimal(12, 2)
  usuario          Usuario         @relation(fields: [id_usuario], references: [id_usuario])
  distrito         Distrito        @relation(fields: [id_distrito], references: [id_distrito])
  detalles         DetallePedido[]
  mensajes         MensajePedido[]
  resenas          ResenaProducto[]

  @@index([id_usuario], map: "idx_pedidos_usuario")
  @@index([id_distrito], map: "idx_pedidos_distrito")
  @@map("pedidos")
}

model DetallePedido {
  id_detalle               Int      @id @default(autoincrement())
  id_pedido                Int
  id_producto              Int
  cantidad                 Int
  precio_unitario_fijado   Decimal  @db.Decimal(10, 2)
  precio_personalizacion   Decimal  @default(0) @db.Decimal(10, 2)
  texto_personalizado      String?
  tecnica_personalizacion  String?  @db.VarChar(50)
  talla                    String?  @db.VarChar(30)
  tamano                   String?  @db.VarChar(50)
  color_producto           String?  @db.VarChar(50)
  fuente_texto             String?  @db.VarChar(80)
  tamano_texto             Int?
  cara                     String?  @db.VarChar(40)
  posicion_x               Decimal? @db.Decimal(5, 2)
  posicion_y               Decimal? @db.Decimal(5, 2)
  imagen_referencia_url    String?  @db.VarChar(500)
  configuracion            Json?
  subtotal                 Decimal  @db.Decimal(12, 2)
  pedido                   Pedido   @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  producto                 Producto @relation(fields: [id_producto], references: [id_producto])

  @@index([id_pedido], map: "idx_detalle_pedidos_pedido")
  @@map("detalle_pedidos")
}

model MensajePedido {
  id_mensaje   Int      @id @default(autoincrement())
  id_pedido    Int
  id_usuario   Int?
  tipo         String   @db.VarChar(40)
  contenido    String
  imagen_url   String?  @db.VarChar(500)
  fecha        DateTime @default(now()) @db.Timestamp(6)
  visible_cliente Boolean @default(true)
  pedido       Pedido   @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade)
  usuario      Usuario? @relation(fields: [id_usuario], references: [id_usuario], onDelete: SetNull)

  @@index([id_pedido], map: "idx_mensajes_pedido")
  @@map("mensajes_pedidos")
}

model ResenaProducto {
  id_resena          Int      @id @default(autoincrement())
  id_producto        Int
  id_usuario         Int
  id_pedido          Int?
  rating             Int
  comentario         String
  compra_verificada  Boolean  @default(false)
  fecha              DateTime @default(now()) @db.Timestamp(6)
  producto           Producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade)
  usuario            Usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade)
  pedido             Pedido?  @relation(fields: [id_pedido], references: [id_pedido], onDelete: SetNull)

  @@unique([id_producto, id_usuario], map: "uq_resena_producto_usuario")
  @@index([id_producto], map: "idx_resenas_producto")
  @@map("resenas_productos")
}
